import pandas as pd
from pathlib import Path

# Get the directory where this script is located
script_dir = Path(__file__).parent

# Read the CSV file using absolute path (with datetime index)
df = pd.read_csv(script_dir / 'general_data_csv_V2.csv', index_col=0, parse_dates=True)

# Days to remove (MM/DD format)
days_to_remove = [
    '05/05', '11/05', '12/05', '14/05', '18/05',
    '10/06', '12/06', '22/06', '29/06',
    '01/07', '04/07', '06/07', '07/07', '09/07', '13/07', '24/07', '30/07',
    '08/08'
]

# Use the datetime index to extract MM/DD
df['date_str'] = df.index.strftime('%m/%d')

# Filter out the rows with unwanted dates
df_filtered = df[~df['date_str'].isin(days_to_remove)]

# Drop the temporary column
df_filtered = df_filtered.drop('date_str', axis=1)

# Remove rows with missing data
df_filtered = df_filtered.dropna()

# Save to new file (using absolute path) - keep the index
df_filtered = df_filtered.dropna(how='any')
df_filtered.to_csv(script_dir / 'general_data_csv_V2_cleaned.csv', index=True)

print("File created: general_data_csv_V2_cleaned.csv")